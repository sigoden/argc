************ RUN ************
prog -h

# OUTPUT
command cat >&2 <<-'EOF' 
Usage: prog [OPTIONS]

Options:
  -h,  -?, --help         Print help
  -v,  -V, --version      Print version
  -f,  -F, --file <FILE>  File

EOF
exit 0

