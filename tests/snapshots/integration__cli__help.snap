---
source: tests/cli.rs
expression: stdout
---
A bash CLI framework and command runner - https://github.com/sigoden/argc

COMMANDS:
    --argc-eval <FILE> <ARGS~>
        Parse arguments and output shell code to eval
        
        Example: eval "$(argc --argc-eval "$0" "$@")"

    --argc-create <-|FILE> <RECIPES~>
        Create a boilerplate argc script. Use '-' as an alias for Argcfile.sh
        
        Examples:
            argc --argc-create - build test            # Create Argcfile.sh
            argc --argc-create mycli foo bar
            argc --argc-create /tmp/mycli foo bar

    --argc-build <FILE> <OUTPATH?>
        Build a standalone script without argc dependency
        
        Examples:
            argc --argc-build ./examples/demo > /tmp/demo
            argc --argc-build ./examples/demo /tmp/demo

    --argc-mangen <FILE> <OUTDIR>
        Generate man pages for a script
        
        Example: argc --argc-mangen ./examples/demo ./man

    --argc-completions <SHELL> <CMDS>
        Generate shell completion scripts
        
        Examples:
            source <(argc --argc-completions bash mycli)
            source <(argc --argc-completions zsh mycli)
            argc --argc-completions powershell mycli | Out-String | Invoke-Expression
            argc --argc-completions fish mycli | source
            argc --argc-completions nushell | save --append $nu.config-path

    --argc-compgen <SHELL> <FILE> <CMD> <ARGS>
        Generate completion candidates.
        
        Examples:
            argc --argc-compgen bash "" demo download --    # Find demo in $PATH
            argc --argc-compgen bash ./examples/demo demo download --

    --argc-export <FILE>
        Export command definitions as JSON
        
        Example: argc --argc-export ./example/demo > demo.json

    --argc-parallel <FILE> <ARGS~>
        Run recipes in parallel
        
        Example: argc --argc-parallel "$0" mycli foo --opt val ::: bar val

    --argc-script-path
        Print the path of the current argcfile

    --argc-shell-path
        Print the path of the current shell

    --argc-help
        Print help information

    --argc-version
        Print version information
