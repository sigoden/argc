---
source: tests/spec.rs
expression: data
---
RUN
prog -h

# OUTPUT
command cat >&2 <<-'EOF' 
Usage: prog [OPTIONS] [URL]

Args:
  [URL]

Options:
      --url <URL>
  -h, --help
  -V, --version

EOF
exit 0

